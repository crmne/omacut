#!/usr/bin/env sh
set -eu

ROOT="$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)"
BUILD_DIR="$ROOT/build/tests"

if command -v qmake6 >/dev/null 2>&1; then
  QMAKE=qmake6
elif command -v qmake >/dev/null 2>&1; then
  QMAKE=qmake
else
  echo "qmake6 or qmake is required to test omacut." >&2
  exit 1
fi

mkdir -p "$BUILD_DIR"
cd "$BUILD_DIR"

"$QMAKE" "$ROOT/tests/backend_tests.pro"
make
# Offscreen, so the QML tests never put windows up on the desktop. Set
# QT_QPA_PLATFORM to watch them on a real display instead.
QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-offscreen}" ./backend_tests
